#!/usr/bin/with-contenv bash
# Refuse to expose anything without credentials: the gateway stays down until all three are set.
missing=""
[ -z "${CUSTOM_USER}" ] && missing="$missing CUSTOM_USER"
[ "${#PASSWORD}" -lt 12 ] && missing="$missing PASSWORD(12+ chars)"
[ "${#MCP_TOKEN}" -lt 24 ] && missing="$missing MCP_TOKEN(24+ chars)"
if [ -n "$missing" ]; then
  echo "[lukethomas] NOT exposing the computer. Missing or weak:$missing" >&2
  touch /run/lukethomas-locked
else
  rm -f /run/lukethomas-locked
fi
