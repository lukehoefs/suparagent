{
	admin off
	auto_https off
}

:{$PORT} {
	handle /healthz {
		respond "ok" 200
	}

	@mcp path /mcp /mcp/*
	handle @mcp {
		@authorized header Authorization "Bearer {$MCP_TOKEN}"
		handle @authorized {
			reverse_proxy {$DESKTOP_HOSTPORT} {
				flush_interval -1
			}
		}
		respond "unauthorized" 401
	}

	# lukethomas's own live view: the app holds the MCP token and bridges the desktop's VNC
	# websocket to Luke's browser. No new access: the MCP tools already see and drive the desktop.
	@viewer {
		path /websockify*
		header Authorization "Bearer {$MCP_TOKEN}"
	}
	handle @viewer {
		reverse_proxy {$DESKTOP_HOSTPORT}
	}

	handle {
		basic_auth {
			{$CUSTOM_USER} {$BASIC_AUTH_HASH}
		}
		handle /websockify* {
			reverse_proxy {$DESKTOP_HOSTPORT}
		}
		handle {
			root * /srv/novnc
			file_server
		}
	}
}
